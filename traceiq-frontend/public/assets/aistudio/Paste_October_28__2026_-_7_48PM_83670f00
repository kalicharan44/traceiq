const TraceNode = ({ title, subtitle, icon: Icon, type, isTarget, status, children }) => {
  const styles = {
    source: 'border-slate-200 bg-white text-slate-700',
    raw: 'border-indigo-200 bg-indigo-50/30 text-indigo-900',
    po: 'border-blue-200 bg-blue-50/30 text-blue-900',
