const RecallCommandCenter = () => {
  const { db, executeRecallAtomically } = useContext(AppContext);
  const [step, setStep] = useState(1);
  const [targetLot, setTargetLot] = useState('RAW-1042');
  const [modalConfig, setModalConfig] = useState({ isOpen: false });
  
  const impact = useMemo(() => {
    if (!targetLot || step < 2) return null;
    return buildTraceabilityGraph(db, targetLot.toUpperCase());
  }, [targetLot, db, step]); 

  const calculateExposure = () => {
    if (!impact) return { fgQtyAtRisk: 0, fgQtyDelivered: 0, customers: 0, financialExposure: 0 };
    
    const fgInvQty = impact.inventory
      .map(id => db.inventory.find(i => i.id === id))
      .filter(i => db.lots.find(l => l.id === i.lotId)?.type === 'FG') 
      .reduce((sum, i) => sum + i.qty, 0);

    const inTransitQty = impact.shipments
      .map(id => db.shipments.find(s => s.id === id))
      .filter(s => s.status === STATUS.IN_TRANSIT)
      .reduce((sum, s) => sum + s.qty, 0);

    const deliveredQty = impact.shipments
      .map(id => db.shipments.find(s => s.id === id))
      .filter(s => s.status === STATUS.DELIVERED)
      .reduce((sum, s) => sum + s.qty, 0);

    return {
      fgQtyAtRisk: fgInvQty + inTransitQty,
      fgQtyDelivered: deliveredQty,
      customers: impact.customers.length,
      financialExposure: (fgInvQty + inTransitQty + deliveredQty) * 125 
    };
  };

  const exposure = calculateExposure();

  const simulateRecall = () => {
    if (!targetLot.trim()) return;
    const cleanTarget = targetLot.trim().toUpperCase();
    const testImpact = buildTraceabilityGraph(db, cleanTarget);
    if (!testImpact) {
      setModalConfig({
        isOpen: true,
        title: "Lot Not Found",
        message: `The Lot ID "${cleanTarget}" could not be found in the system. Please check the ID and try again.`,
        isAlert: true,
        onConfirm: () => setModalConfig({ isOpen: false }),
        confirmText: "Acknowledge"
      });
      return;
    }
    setTargetLot(cleanTarget);
    setStep(2);
  };

  const handleExecuteRequest = () => {
    const isAlreadyExecuted = db.auditEvents.some(e => e.action === 'RECALL_EXECUTED' && e.target === targetLot);

    if (isAlreadyExecuted) {
      setModalConfig({
        isOpen: true,
        title: "Duplicate Execution Prevented",
        message: "A recall has already been executed for this incident scope. The affected inventory is already locked.",
        isAlert: true,
        onConfirm: () => {
          setModalConfig({ isOpen: false });
          setStep(4);
        },
        confirmText: "View Report"
      });
      return;
    }

    setModalConfig({
      isOpen: true,
      title: "Authorization Required",
      message: "Are you sure you want to execute quarantine protocols on all affected downstream lots?\n\nThis is a destructive action that will permanently lock warehouse inventory, halt active transit shipments, and flag delivered shipments for customer notification.",
      isDanger: true,
      onConfirm: () => {
        setModalConfig({ isOpen: false });
        executeRecallAtomically(targetLot, impact, exposure);
        setStep(4);
      },
      onCancel: () => setModalConfig({ isOpen: false }),
      confirmText: "Authorize & Execute",
      cancelText: "Cancel"
    });
  };

  const StepIndicator = () => (
    <div className="hidden sm:flex items-center justify-between mb-10 relative px-4">
      <div className="absolute top-1/2 left-0 w-full h-0.5 bg-slate-200 -z-10 -translate-y-1/2" />
      {['Identify', 'Impact Analysis', 'Action Plan', 'Reconciliation'].map((label, i) => {
        const isActive = step === i + 1;
        const isPassed = step > i + 1;
        return (
          <div key={i} className="flex flex-col items-center relative bg-slate-50 px-4">
            <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm transition-all duration-300 shadow-sm
              ${isPassed ? 'bg-teal-500 text-white' : isActive ? 'bg-blue-600 text-white ring-4 ring-blue-600/20' : 'bg-white border-2 border-slate-200 text-slate-400'}`}>
              {isPassed ? <CheckCircle className="w-5 h-5" /> : i + 1}
            </div>
            <span className={`absolute top-12 whitespace-nowrap text-sm font-semibold transition-colors
              ${isActive ? 'text-blue-700' : isPassed ? 'text-slate-700' : 'text-slate-400'}`}>{label}</span>
          </div>
        )
      })}
    </div>
  );

  return (
    <div className="p-8 max-w-6xl mx-auto space-y-8">
      <Modal {...modalConfig} />
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h1 className="text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-3">
            <div className="p-2 bg-red-100 rounded-lg"><ShieldAlert className="w-6 h-6 text-red-600" /></div>
            Recall Command Center
          </h1>
          <p className="text-slate-500 mt-2">Manage incidents, analyze exposure, and execute quarantine protocols securely.</p>
        </div>
        {step > 1 && <Button variant="secondary" onClick={() => setStep(1)} icon={ArrowLeft}>New Simulation</Button>}
      </div>

      <StepIndicator />
      <div className="mt-16" />

      {step === 1 && (
        <Card className="p-10 max-w-2xl mx-auto text-center animate-in fade-in zoom-in-95 border-slate-200">
          <div className="w-20 h-20 bg-amber-50 rounded-full flex items-center justify-center mx-auto mb-6">
             <SearchCode className="w-10 h-10 text-amber-500" />
          </div>
          <h2 className="text-2xl font-bold text-slate-900 tracking-tight">Identify Suspect Material</h2>
          <p className="text-slate-500 mt-3 max-w-md mx-auto leading-relaxed">Enter the defective lot number to safely build the traceability graph and calculate downstream exposure without altering operational data.</p>
          
          <div className="text-left mt-8 mb-6 relative">
            <input 
              type="text" 
              value={targetLot} 
              onChange={(e) => setTargetLot(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && simulateRecall()}
              className="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none font-mono text-lg shadow-inner transition-all placeholder:text-slate-400 text-slate-900" 
              placeholder="e.g. RAW-1042"
            />
            <div className="absolute right-4 top-1/2 -translate-y-1/2 px-2 py-1 bg-white border border-slate-200 rounded text-xs font-semibold text-slate-400">LOT ID</div>
          </div>
          <Button onClick={simulateRecall} className="w-full text-base py-4 rounded-xl shadow-lg shadow-blue-500/20" icon={SearchCode}>Calculate Exposure Impact</Button>
        </Card>
      )}

      {step === 2 && impact && (
        <div className="space-y-6 animate-in slide-in-from-right-4 duration-300">
