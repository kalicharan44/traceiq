// --- Main Application Wrapper ---
export default function App() {
  const [activeTab, setActiveTab] = useState('dashboard');
  const [db, setDb] = useLocalStorageState('sc-demo-db', INITIAL_DATA);
  const [globalSearchTarget, setGlobalSearchTarget] = useState('');
  const [resetModalConfig, setResetModalConfig] = useState({ isOpen: false });

  const requestReset = () => {
    setResetModalConfig({
      isOpen: true,
      title: "Reset Demo Environment",
      message: "Are you sure you want to reset the demo to its initial state? All your progress, audit logs, and simulated recalls will be permanently lost.",
      isDanger: true,
      onConfirm: () => {
        setDb(deepClone(INITIAL_DATA));
        setActiveTab('dashboard');
        setResetModalConfig({ isOpen: false });
      },
      onCancel: () => setResetModalConfig({ isOpen: false }),
      confirmText: "Reset Environment",
      cancelText: "Cancel"
    });
  };

  const addAuditEvent = (action, target, details) => {
    setDb(prev => ({
      ...prev,
      auditEvents: [{
        id: generateId(),
        timestamp: new Date().toISOString(),
        actor: 'Admin User (Demo)',
        action,
        target,
        details
      }, ...prev.auditEvents]
    }));
  };

  const executeRecallAtomically = (targetLot, impact, exposure) => {
    setDb(prev => {
      const nextDb = deepClone(prev);
      
      impact.rawLots.concat(impact.fgLots).forEach(lotId => {
        const lot = nextDb.lots.find(l => l.id === lotId);
        if (lot) lot.status = STATUS.QUARANTINED;
      });

      impact.inventory.forEach(invId => {
        const inv = nextDb.inventory.find(i => i.id === invId);
        if (inv) inv.status = STATUS.QUARANTINED;
      });

      impact.shipments.forEach(shpId => {
        const shp = nextDb.shipments.find(s => s.id === shpId);
        if (shp) {
          if (shp.status === STATUS.IN_TRANSIT) {
            shp.status = STATUS.HOLD;
          } else if (shp.status === STATUS.DELIVERED && !shp.recallStatus) {
            shp.recallStatus = 'NOTIFIED';
            shp.notificationTimestamp = new Date().toISOString();
          }
        }
      });

      nextDb.auditEvents.unshift({
        id: generateId(),
        timestamp: new Date().toISOString(),
        actor: 'Admin User (Demo)',
        action: 'RECALL_EXECUTED',
        target: targetLot,
        details: `Quarantined ${exposure.fgQtyAtRisk} units across ${impact.inventory.length} warehouses and placed holds on active shipments.`
      });

      return nextDb;
    });
  };

  const contextValue = {
    db, setDb, activeTab, setActiveTab, resetDemo: requestReset, addAuditEvent,
    globalSearchTarget, setGlobalSearchTarget, executeRecallAtomically
  };

  const renderContent = () => {
    switch (activeTab) {
      case 'dashboard': return <Dashboard />;
      case 'traceability': return <Traceability />;
      case 'recall': return <RecallCommandCenter />;
      case 'ai': return <AIInvestigation />;
      case 'anomalies': return <Anomalies />;
      case 'audit': return <AuditLog />;
      default: return <Dashboard />;
    }
  };

  return (
    <AppContext.Provider value={contextValue}>
      <Modal {...resetModalConfig} />
      <div className="flex h-screen bg-[#F8FAFC] overflow-hidden font-sans text-slate-900 selection:bg-blue-200 selection:text-blue-900">
        <Sidebar />
        <div className="flex-1 flex flex-col min-w-0 relative">
          <Header />
          <main className="flex-1 overflow-y-auto pb-12">
            {renderContent()}
          </main>
        </div>
      </div>
    </AppContext.Provider>
  );
}