const AIInvestigation = () => {
  const { db } = useContext(AppContext);
  const [messages, setMessages] = useState([
    { role: 'ai', content: "Hello. I am the NexusChain AI Investigator. **Note: I am a simulated demo feature and do not connect to a live LLM.**\n\nI can parse intent and query our local dataset for traceability insights, anomaly summaries, and draft reports. What would you like to investigate?" }
  ]);
  const [input, setInput] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const chatEndRef = useRef(null);
  const timeoutRef = useRef(null);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, isTyping]);

  useEffect(() => {
    return () => {
      if (timeoutRef.current) clearTimeout(timeoutRef.current);
    };
  }, []);

  const handleSend = () => {
    if (!input.trim() || isTyping) return;
    
    const userMsg = input.trim();
    setMessages(prev => [...prev, { role: 'user', content: userMsg }]);
    setInput('');
    setIsTyping(true);

    timeoutRef.current = setTimeout(() => {
      let aiResponse = "";
      const lowerInput = userMsg.toLowerCase();
      
      const idMatch = userMsg.match(/([A-Z]+-\d+|RAW-MISSING)/i);
      const detectedId = idMatch ? idMatch[0].toUpperCase() : null;

      if (detectedId && (lowerInput.includes('trace') || lowerInput.includes('affect') || lowerInput.includes(detectedId.toLowerCase()))) {
        const impact = buildTraceabilityGraph(db, detectedId);
        if (impact) {
            const missingWarning = impact.missingLots.length > 0 ? `\n\n⚠️ **Traceability Gap Detected:**\nThe following upstream links are missing from the system: **${impact.missingLots.join(', ')}**.` : '';
            aiResponse = `**Traceability Analysis for ${detectedId}:**\nI've analyzed the genealogy graph. The lot is connected to production orders **${impact.pos.join(', ') || 'none'}**, yielding finished goods **${impact.fgLots.join(', ') || 'none'}**.\n\nCurrently, there are **${impact.inventory.length}** inventory locations and **${impact.shipments.length}** shipments affected, exposing **${impact.customers.length}** customers.${missingWarning}`;
        } else {
            aiResponse = `I could not locate **${detectedId}** in the current dataset. Please verify the ID.`;
        }
      } else if (lowerInput.includes('report') || lowerInput.includes('draft')) {
         aiResponse = `**DRAFT RECALL INCIDENT REPORT**\n\n**Date:** ${new Date().toLocaleDateString()}\n**Trigger Event:** Quality deviation detected.\n\n**Action Required:** Immediate quarantine of active stock and issue return notices to affected customers.\n\n*Note: This is a generated template based on current state. Navigate to the Recall Command Center to officially authorize execution.*`;
      } else if (lowerInput.includes('anomaly') || lowerInput.includes('gap') || lowerInput.includes('unreconciled')) {
        aiResponse = `I've detected the following discrepancies in the dataset:\n\n1. **Orphaned Input:** FG-4001 was produced using \`RAW-MISSING\`, which lacks a valid supplier registry entry.\n2. **Over-Allocation:** Shipment SHP-003 shows 500 units of FG-4001 delivered, but production order PO-9999 only yielded 200 units.\n\nI highly recommend reviewing the Anomaly Detection module for details.`;
      } else {
        aiResponse = "I am analyzing the network for your request. Based on the current deterministic state, operations outside the known anomaly zones are nominal. Could you provide a specific Lot ID (e.g., RAW-1042) or refine your query?";
      }

      setIsTyping(false);
      setMessages(prev => [...prev, { role: 'ai', content: aiResponse }]);
    }, 1200);
  };

  return (
    <div className="p-8 max-w-5xl mx-auto h-[calc(100vh-64px)] flex flex-col">
      <div className="mb-6">
        <h1 className="text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-3">
           <div className="p-2 bg-violet-100 rounded-lg"><Sparkles className="w-6 h-6 text-violet-600" /></div>
           AI Investigator <Badge status="VIOLET" className="ml-2">SIMULATED DEMO</Badge>
        </h1>
        <p className="text-slate-500 mt-2">Natural language interface for deep network querying and report generation.</p>
      </div>

      <Card className="flex-1 flex flex-col overflow-hidden bg-white shadow-xl shadow-slate-200/50 border-slate-200/60 p-0 rounded-2xl">
        <div className="flex-1 overflow-y-auto p-6 space-y-6 bg-slate-50/30">
        {messages.map((msg, idx) => (
          <div key={idx} className={`flex gap-4 ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
              {msg.role === 'ai' && (
                <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shrink-0 shadow-sm">
                  <Sparkles className="w-5 h-5 text-white" />
                </div>
              )}
              <div className={`max-w-[80%] p-4 text-sm leading-relaxed whitespace-pre-wrap shadow-sm ${
                msg.role === 'user' 
                  ? 'bg-blue-600 text-white rounded-2xl rounded-br-sm' 
                  : 'bg-white text-slate-800 border border-slate-200 rounded-2xl rounded-bl-sm font-medium'
              }`}>
                {msg.content}
              </div>
            </div>
          ))}
          {isTyping && (
             <div className="flex gap-4 justify-start">
               <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shrink-0 shadow-sm">
                  <Sparkles className="w-5 h-5 text-white" />
                </div>
                <div className="bg-white border border-slate-200 rounded-2xl rounded-bl-sm p-4 shadow-sm flex items-center gap-1.5">
                  <div className="w-2 h-2 bg-violet-400 rounded-full animate-bounce" style={{ animationDelay: '0ms' }} />
                  <div className="w-2 h-2 bg-violet-400 rounded-full animate-bounce" style={{ animationDelay: '150ms' }} />
                  <div className="w-2 h-2 bg-violet-400 rounded-full animate-bounce" style={{ animationDelay: '300ms' }} />
                </div>
             </div>
          )}
          <div ref={chatEndRef} />
        </div>
        
        <div className="p-6 bg-white border-t border-slate-100">
          <div className="flex gap-2 mb-4 overflow-x-auto pb-2 hide-scrollbar">
            {["Analyze impact of RAW-1042", "Are there any traceability gaps?", "Draft a recall report for management"].map(prompt => (
              <button key={prompt} onClick={() => setInput(prompt)} className="whitespace-nowrap px-4 py-2 bg-slate-50 border border-slate-200 rounded-full text-xs font-semibold text-slate-600 hover:border-violet-300 hover:text-violet-700 hover:bg-violet-50 transition-all shadow-sm">
                {prompt}
              </button>
            ))}
          </div>
          <div className="relative">
            <input 
              type="text"
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && handleSend()}
              placeholder="Ask the AI investigator..."
              className="w-full pl-5 pr-14 py-4 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-violet-500 shadow-inner text-sm font-medium transition-all"
            />
            <button 
              onClick={handleSend}
              disabled={!input.trim() || isTyping}
              className="absolute right-2.5 top-1/2 -translate-y-1/2 p-2 bg-violet-600 text-white rounded-lg hover:bg-violet-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-sm"
            >
              <ArrowRight className="w-4 h-4" />
            </button>
          </div>
        </div>
      </Card>
    </div>
  );
};

