    missing: 'border-red-300 bg-red-50 text-red-900 border-dashed'
  };

  return (
    <div className={`relative p-4 rounded-xl border-2 w-64 shadow-sm transition-all hover:shadow-md ${styles[type]} ${isTarget ? 'ring-4 ring-blue-500/20 border-blue-500 shadow-blue-500/10' : ''}`}>
