# Local quickstart uses SQLite. Replace with the PostgreSQL URL for PostgreSQL-backed development.
DATABASE_URL=sqlite:///./traceiq.db
# PostgreSQL example: postgresql+psycopg://traceiq:traceiq@localhost:5432/traceiq
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LOAD_DEMO_DATA=false
LOAD_FULL_DATASET=false
# Apply versioned migrations with `alembic upgrade head` before starting the API.
AUTO_CREATE_SCHEMA=false
PRIVATE_STORAGE_DIR=./private_uploads
MAX_DOCUMENT_BYTES=15728640
MAX_DOCUMENT_PAGES=150
MAX_UPLOAD_BATCH=10
